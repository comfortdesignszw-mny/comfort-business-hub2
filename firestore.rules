rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. PRIMITIVES & HELPERS
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() { 
      return isSignedIn() && (
        request.auth.token.email == "comfort.designszw@gmail.com" || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true)
      ); 
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // 2. ENTITY VALIDATORS
    function isValidUser(data) {
      return data.uid == request.auth.uid
        && (data.name is string && data.name.size() <= 100)
        && (!('currentRole' in data) || (data.currentRole in ['customer', 'supplier']))
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 20))
        && (!('email' in data) || (data.email is string && data.email.size() <= 100))
        && (!('avatar' in data) || (data.avatar is string && data.avatar.size() <= 2056))
        && (!('requiredProducts' in data) || (data.requiredProducts is list && data.requiredProducts.size() <= 50));
    }

    function isValidStore(data) {
      return data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && (!('geohash' in data) || (data.geohash is string && data.geohash.size() <= 32))
        && (!('description' in data) || (data.description is string && data.description.size() <= 5000))
        && (!('contactNumbers' in data) || (data.contactNumbers is list && data.contactNumbers.size() <= 5))
        && (!('logo' in data) || (data.logo is string && data.logo.size() <= 2056));
    }

    function isValidProduct(data) {
      return data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 150
        && data.price is number && data.price >= 0
        && (!('images' in data) || (data.images is list && data.images.size() <= 10))
        && data.buyButtonType in ['checkout', 'chat', 'link', 'ecocash', 'pod'];
    }

    function isValidReview(data) {
      return data.userId == request.auth.uid
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && (!('comment' in data) || (data.comment is string && data.comment.size() <= 1000));
    }

    function isValidDeal(data) {
      return (data.supplierId == request.auth.uid || data.customerId == request.auth.uid)
        && data.status in ['pending', 'quoted', 'accepted', 'delivered', 'cancelled'];
    }

    function isValidPublicProfile(data) {
      return data.uid == request.auth.uid
        && data.name is string && data.name.size() <= 100
        && data.currentRole in ['customer', 'supplier']
        && data.isVerified == (request.auth.token.email_verified == true);
    }

    // 3. COLLECTIONS

    match /reports/{id} {
      allow create: if isSignedIn() && isValidId(id) && incoming().reporterId == request.auth.uid;
      allow get, list, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin(); 
      allow create: if isOwner(userId) && isValidId(userId);
      allow update: if isOwner(userId) || isAdmin();
    }

    match /public_profiles/{userId} {
      allow get, list: if isSignedIn();
      allow create, update: if (isOwner(userId) || isAdmin()) && isValidId(userId) && isValidPublicProfile(incoming()) && incoming().updatedAt == request.time;
      allow delete: if isOwner(userId) || isAdmin();
    }

    match /stores/{storeId} {
      allow get: if true;
      allow list: if true; 
      allow create: if isVerified() && isValidStore(incoming()) && isValidId(storeId) && incoming().updatedAt == request.time;
      allow update: if isSignedIn() && (
        // Tier 1: Owner Update
        (isOwner(existing().ownerId) && isValidStore(incoming()) 
          && incoming().ownerId == existing().ownerId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'contactNumbers', 'email', 'category', 'logo', 'coverPhoto', 'address', 'specificBusinessType', 'geohash', 'lat', 'lng', 'updatedAt', 'followerCount', 'likeCount', '_syncedAt']))
        || 
        // Tier 2: Public Interactions (Follow/Like)
        (incoming().diff(existing()).affectedKeys().hasOnly(['followerCount', 'likeCount']) 
          && incoming().ownerId == existing().ownerId)
      );
      allow delete: if isOwner(existing().ownerId);
    }

    match /products/{productId} {
      allow get: if true;
      allow list: if true;
      allow create: if isVerified() && isValidProduct(incoming()) && isValidId(productId) && incoming().updatedAt == request.time
        && get(/databases/$(database)/documents/stores/$(incoming().storeId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        // Tier 1: Owner Update
        (isOwner(existing().ownerId) && isValidProduct(incoming())
          && incoming().ownerId == existing().ownerId
          && incoming().storeId == existing().storeId
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'price', 'currency', 'category', 'images', 'buyButtonType', 'buyButtonLink', 'isActive', 'rating', 'reviewCount', 'likeCount', 'updatedAt', '_syncedAt']))
        ||
        // Tier 2: Public Feedback (Rating/Likes)
        (incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'reviewCount', 'likeCount'])
          && incoming().ownerId == existing().ownerId)
      );
      allow delete: if isOwner(existing().ownerId);
    }

    match /deals/{id} {
      allow get: if isSignedIn() && (resource.data.supplierId == request.auth.uid || resource.data.customerId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.supplierId == request.auth.uid || resource.data.customerId == request.auth.uid);
      allow create: if isVerified() && isValidId(id) && isValidDeal(incoming()) && incoming().updatedAt == request.time;
      allow update: if isVerified() && isValidDeal(incoming())
        && (existing().supplierId == request.auth.uid || existing().customerId == request.auth.uid)
        && incoming().updatedAt == request.time
        && existing().status != 'delivered' && existing().status != 'cancelled' // Locking terminal states
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'agreedPrice', 'customerNotes', 'supplierNotes', 'updatedAt']);
    }

    match /notifications/{id} {
      allow get, delete: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().fromUserId == request.auth.uid;
      allow update: if isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt', '_syncedAt']);
    }

    match /conversations/{convoId} {
      allow create: if isSignedIn() && request.auth.uid in incoming().participants;
      allow get, update: if isSignedIn() && request.auth.uid in existing().participants;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow get, list: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        allow create: if isSignedIn() && isValidId(messageId)
          && incoming().senderId == request.auth.uid
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
      }
    }

    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isVerified() && isValidId(reviewId) && isValidReview(incoming());
      allow delete: if isOwner(existing().userId);
    }

    match /follows/{id} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.storeId is string);
      allow create: if isSignedIn() && isValidId(id) && incoming().userId == request.auth.uid;
      allow delete: if isOwner(existing().userId);
    }

    match /storeLikes/{id} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(id) && incoming().userId == request.auth.uid;
      allow delete: if isOwner(existing().userId);
    }

    match /productLikes/{id} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(id) && incoming().userId == request.auth.uid;
      allow delete: if isOwner(existing().userId);
    }
    
    match /engagements/{id} {
      allow get, list: if isSignedIn() && (resource.data.supplierId == request.auth.uid || resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(id) && incoming().customerId == request.auth.uid;
    }

    match /spotlights/{id} {
      allow get, list: if true;
      allow create: if isVerified() && isValidId(id) && incoming().authorId == request.auth.uid;
      allow update: if isOwner(existing().authorId) 
        && incoming().authorId == existing().authorId
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'type', 'image', 'location', 'date', 'isActive', 'updatedAt', '_syncedAt']);
      allow delete: if isOwner(existing().authorId);
    }

    match /connections/{id} {
      allow get, list: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(id) && incoming().senderId == request.auth.uid;
      allow update: if isSignedIn() && (
        (existing().receiverId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'type', 'updatedAt', '_syncedAt'])) ||
        (existing().senderId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', '_syncedAt']))
      );
      allow delete: if isSignedIn() && (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid);
    }
  }
}

