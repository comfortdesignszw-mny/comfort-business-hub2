rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. GLOBAL SAFETY NET
    match /{document=**} { allow read, write: if false; }

    // Health Check (Anonymous connection diagnostic)
    match /test/connection {
      allow read: if true;
    }

    // 1. PRIMITIVES & HELPERS
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // 2. ENTITY VALIDATORS
    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.name is string && data.name.size() <= 100
        && data.phone is string && data.phone.size() <= 20
        && data.currentRole in ['customer', 'supplier']
        && (!('email' in data) || (data.email is string && data.email.size() <= 100))
        && (!('fcmToken' in data) || (data.fcmToken is string && data.fcmToken.size() <= 512));
    }

    function isValidStore(data) {
      return data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 500
        && (!('geohash' in data) || data.geohash == null || (data.geohash is string && data.geohash.size() <= 128))
        && (!('category' in data) || data.category == null || (data.category is string && data.category.size() <= 200))
        && (!('description' in data) || data.description == null || (data.description is string && data.description.size() <= 10000))
        && (!('logo' in data) || data.logo == null || (data.logo is string && data.logo.size() <= 1000000))
        && (!('coverPhoto' in data) || data.coverPhoto == null || (data.coverPhoto is string && data.coverPhoto.size() <= 1000000))
        && (!('address' in data) || data.address == null || (data.address is string && data.address.size() <= 1000));
    }

    function isValidProduct(data) {
      return data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.price is number && data.price >= 0
        && data.buyButtonType in ['checkout', 'chat', 'link', 'ecocash', 'pod'];
    }

    function isValidNotification(data) {
      return data.userId is string && data.userId.size() <= 128
        && data.fromUserId == request.auth.uid
        && data.type in ['engage', 'buy', 'rate', 'follow', 'like_store', 'like_product'];
    }

    // 3. COLLECTIONS
    match /users/{userId} {
      allow read: if true;
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && isValidUser(incoming())
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'avatar', 'currentRole', 'geohash', 'lat', 'lng', 'businessName', 'businessCategory', 'whatsappUrl', 'requiredProducts', 'location', 'gateway', 'isVerified', 'fcmToken', 'updatedAt', '_syncedAt', 'uid']);
    }

    match /stores/{storeId} {
      allow read: if true;
      allow create: if isVerified() && isValidStore(incoming()) && isValidId(storeId);
      allow update: if isSignedIn() && (
        (isOwner(existing().ownerId) && isValidStore(incoming()) 
          && incoming().ownerId == existing().ownerId
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'contactNumbers', 'email', 'category', 'logo', 'coverPhoto', 'address', 'specificBusinessType', 'geohash', 'lat', 'lng', 'updatedAt', 'followerCount', 'likeCount', 'ownerId', '_syncedAt']))
        || (incoming().diff(existing()).affectedKeys().hasOnly(['followerCount', 'likeCount']) && incoming().ownerId == existing().ownerId)
      );
      allow delete: if isOwner(existing().ownerId);
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if isVerified() && isValidProduct(incoming()) && isValidId(productId)
        && get(/databases/$(database)/documents/stores/$(incoming().storeId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        (isOwner(existing().ownerId) && isValidProduct(incoming()) 
          && incoming().ownerId == existing().ownerId
          && incoming().storeId == existing().storeId
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'price', 'currency', 'category', 'images', 'buyButtonType', 'buyButtonLink', 'isActive', 'rating', 'reviewCount', 'likeCount', 'updatedAt', 'ownerId', 'storeId', '_syncedAt']))
        || (incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'reviewCount', 'likeCount']))
      );
      allow delete: if isOwner(existing().ownerId);
    }

    match /notifications/{id} {
      allow read: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidNotification(incoming());
      allow update: if isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt', '_syncedAt']);
      allow delete: if isOwner(existing().userId);
    }

    match /conversations/{convoId} {
      allow create: if isSignedIn() && request.auth.uid in incoming().participants;
      allow read, update: if isSignedIn() && request.auth.uid in existing().participants;

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        allow create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants
          && incoming().senderId == request.auth.uid
          && incoming().text.size() <= 5000;
      }
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isVerified() && incoming().userId == request.auth.uid;
      allow delete: if isOwner(existing().userId);
    }

    match /follows/{id} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isOwner(existing().userId);
    }

    match /storeLikes/{id} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isOwner(existing().userId);
    }

    match /productLikes/{id} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isOwner(existing().userId);
    }
    
    match /engagements/{id} {
      allow read: if isSignedIn() && (resource.data.supplierId == request.auth.uid || resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn() && incoming().customerId == request.auth.uid;
    }

    match /deals/{id} {
      allow read: if isSignedIn() && (resource.data.supplierId == request.auth.uid || resource.data.customerId == request.auth.uid);
      allow write: if isVerified() && (incoming().supplierId == request.auth.uid || incoming().customerId == request.auth.uid);
    }

    match /spotlights/{id} {
      allow read: if true;
      allow create: if isVerified() && incoming().authorId == request.auth.uid;
      allow update, delete: if isOwner(existing().authorId) && (request.method == 'delete' || incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'type', 'date', 'location', 'image', 'isActive', 'updatedAt', '_syncedAt', 'authorId']));
    }
  }
}
