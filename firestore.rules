rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Health Check
    match /test/{document=**} {
      allow read: if true;
    }

    // 1. PRIMITIVES & HELPERS
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function isAdmin() { 
      return isSignedIn() && (
        isHardcodedAdmin() || 
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true)
      ); 
    }
    function isHardcodedAdmin() {
      return isSignedIn() && request.auth.token.email == "comfort.designszw@gmail.com";
    }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() > 0 && id.size() <= 128; }

    // 2. ENTITY VALIDATORS
    function isValidUser(data) {
      return (!('uid' in data) || data.uid == request.auth.uid)
        && (!('name' in data) || data.name == null || (data.name is string && data.name.size() <= 200))
        && (!('currentRole' in data) || data.currentRole == null || data.currentRole is string)
        && (!('phone' in data) || data.phone == null || (data.phone is string && data.phone.size() <= 50))
        && (!('email' in data) || data.email == null || (data.email is string && data.email.size() <= 100))
        && (!('avatar' in data) || data.avatar == null || (data.avatar is string && data.avatar.size() <= 1000000))
        && (!('requiredProducts' in data) || (data.requiredProducts is list && data.requiredProducts.size() <= 50));
    }

    function isValidStore(data) {
      return data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 200
        && (!('geohash' in data) || (data.geohash is string && data.geohash.size() <= 32))
        && (!('description' in data) || (data.description is string && data.description.size() <= 5000))
        && (!('contactNumbers' in data) || (data.contactNumbers is list && data.contactNumbers.size() <= 10))
        && (!('logo' in data) || data.logo == null || (data.logo is string && data.logo.size() <= 500000))
        && (!('coverPhoto' in data) || data.coverPhoto == null || (data.coverPhoto is string && data.coverPhoto.size() <= 500000))
        && (!('isVerified' in data) || data.isVerified is bool);
    }

    function isValidProduct(data) {
      return data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 150
        && data.price is number && data.price >= 0
        && (!('images' in data) || (data.images is list && data.images.size() <= 10))
        && (!('buyButtonType' in data) || data.buyButtonType is string)
        && (!('isVerified' in data) || data.isVerified is bool);
    }

    function isValidReview(data) {
      return data.userId == request.auth.uid
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && (!('comment' in data) || (data.comment is string && data.comment.size() <= 1000));
    }

    function isValidDeal(data) {
      return (data.supplierId == request.auth.uid || data.customerId == request.auth.uid)
        && (!('status' in data) || data.status is string);
    }

    // 3. COLLECTIONS

    match /reports/{id} {
      allow create: if isSignedIn() && isValidId(id);
      allow list, get: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /public_profiles/{userId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /stores/{storeId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidStore(incoming()) && isValidId(storeId);
      allow update: if isHardcodedAdmin() || isAdmin() || (isSignedIn() && isOwner(existing().ownerId)) || 
        incoming().diff(existing()).affectedKeys().hasOnly(['followerCount', 'likeCount', 'rating', 'reviewCount', 'orderClicks', 'whatsappClicks', 'estimatedSalesUsd', 'updatedAt', '_syncedAt']);
      allow delete: if isSignedIn() && (isOwner(existing().ownerId) || isHardcodedAdmin() || isAdmin());
    }

    match /products/{productId} {
      allow get, list: if true;
      allow create: if isSignedIn() && isValidProduct(incoming()) && isValidId(productId);
      allow update: if isHardcodedAdmin() || isAdmin() || (isSignedIn() && isOwner(existing().ownerId)) || 
        incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'reviewCount', 'likeCount', 'updatedAt', '_syncedAt']);
      allow delete: if isSignedIn() && (isOwner(existing().ownerId) || isHardcodedAdmin() || isAdmin());
    }

    match /deals/{id} {
      allow get, list: if isHardcodedAdmin() || isAdmin() || (
        resource.data.supplierId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        resource.data.isGuestOrder == true
      );
      allow create: if isValidId(id);
      allow update: if isHardcodedAdmin() || isAdmin() || (
        resource.data.supplierId == request.auth.uid ||
        resource.data.customerId == request.auth.uid ||
        resource.data.isGuestOrder == true
      );
      allow delete: if isSignedIn() && (isOwner(existing().supplierId) || isOwner(existing().customerId) || isAdmin());
    }

    match /notifications/{id} {
      allow create: if true;
      allow get, list, update, delete: if isSignedIn();
    }

    match /conversations/{convoId} {
      allow create, get, list, update, delete: if true;

      match /messages/{messageId} {
        allow create, get, list, update, delete: if true;
      }
    }

    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /storeReviews/{reviewId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /follows/{id} {
      allow get, list, create, delete: if isSignedIn();
    }

    match /storeLikes/{id} {
      allow get, list, create, delete: if isSignedIn();
    }

    match /productLikes/{id} {
      allow get, list, create, delete: if isSignedIn();
    }
    
    match /engagements/{id} {
      allow get, list: if isHardcodedAdmin() || isAdmin() || (
        isSignedIn() && (
          resource.data.supplierId == request.auth.uid ||
          resource.data.customerId == request.auth.uid
        )
      );
      allow create: if true;
      allow update, delete: if isHardcodedAdmin() || isAdmin() || (
        isSignedIn() && (
          resource.data.supplierId == request.auth.uid ||
          resource.data.customerId == request.auth.uid
        )
      );
    }

    match /spotlights/{id} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /connections/{id} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // Custom Password Reset Tokens & Rate Limits: Strict Server/Admin SDK only
    match /passwordResetTokens/{id} {
      allow read, write: if false;
    }

    match /rateLimits/{id} {
      allow read, write: if false;
    }
  }
}

