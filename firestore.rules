rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. GLOBAL SAFETY NET
    match /{document=**} { allow read, write: if false; }

    // Health Check (Anonymous connection diagnostic)
    match /test/connection {
      allow read: if true;
    }

    // 1. PRIMITIVES & HELPERS
    function isSignedIn() { return request.auth != null; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isValidId(id) { return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }

    // 2. ENTITY VALIDATORS (Anti-Shadow Update)
    function isValidUser(data) {
      return data.uid == request.auth.uid
        && data.name is string && data.name.size() <= 100
        && data.currentRole in ['customer', 'supplier']
        && (!('phone' in data) || (data.phone is string && data.phone.size() <= 20))
        && (!('email' in data) || (data.email is string && data.email.size() <= 100));
    }

    function isValidStore(data) {
      return data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 500
        && (!('geohash' in data) || (data.geohash is string && data.geohash.size() <= 128))
        && (!('category' in data) || (data.category is string && data.category.size() <= 200))
        && (!('description' in data) || (data.description is string && data.description.size() <= 10000));
    }

    function isValidProduct(data) {
      return data.ownerId == request.auth.uid
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.price is number && data.price >= 0
        && data.buyButtonType in ['checkout', 'chat', 'link', 'ecocash', 'pod'];
    }

    function isValidReview(data) {
      return data.userId == request.auth.uid
        && data.productId is string && data.productId.size() <= 128
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && (!('comment' in data) || (data.comment is string && data.comment.size() <= 2000));
    }

    function isValidMessage(data) {
      return data.senderId == request.auth.uid
        && data.text is string && data.text.size() <= 5000
        && data.conversationId is string && data.conversationId.size() <= 128;
    }

    function isValidPublicProfile(data) {
      return data.uid == request.auth.uid
        && data.name is string && data.name.size() <= 100
        && data.currentRole in ['customer', 'supplier']
        && data.isVerified is bool;
    }

    function isValidSpotlight(data) {
      return data.authorId == request.auth.uid
        && data.title is string && data.title.size() >= 2 && data.title.size() <= 100
        && data.content is string && data.content.size() >= 10 && data.content.size() <= 5000
        && data.type in ['news', 'event', 'update', 'spotlight']
        && data.isActive is bool
        && (!('location' in data) || (data.location is string && data.location.size() <= 200))
        && (!('date' in data) || (data.date is string && data.date.size() <= 100))
        && (!('image' in data) || (data.image is string && data.image.size() <= 2000));
    }

    // 3. COLLECTIONS
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; 
      allow create: if isOwner(userId) && isValidUser(incoming()) && isValidId(userId);
      allow update: if isOwner(userId) && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'phone', 'avatar', 'currentRole', 'geohash', 'lat', 'lng', 'businessName', 'businessCategory', 'whatsappUrl', 'requiredProducts', 'location', 'gateway', 'isVerified', 'fcmToken', 'updatedAt', '_syncedAt', 'uid']);
    }

    match /public_profiles/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create, update: if isOwner(userId) && isValidPublicProfile(incoming()) && isValidId(userId);
      allow delete: if isOwner(userId);
    }

    match /stores/{storeId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isVerified() && isValidStore(incoming()) && isValidId(storeId);
      allow update: if isSignedIn() && (
        (isOwner(existing().ownerId) && isValidStore(incoming()) 
          && incoming().ownerId == existing().ownerId
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'contactNumbers', 'email', 'category', 'logo', 'coverPhoto', 'address', 'specificBusinessType', 'geohash', 'lat', 'lng', 'updatedAt', 'followerCount', 'likeCount', 'ownerId', '_syncedAt', 'statsResetAt']))
        || (incoming().diff(existing()).affectedKeys().hasOnly(['followerCount', 'likeCount']) && incoming().ownerId == existing().ownerId)
      );
      allow delete: if isOwner(existing().ownerId);
    }

    match /products/{productId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isVerified() && isValidProduct(incoming()) && isValidId(productId)
        && get(/databases/$(database)/documents/stores/$(incoming().storeId)).data.ownerId == request.auth.uid;
      allow update: if isSignedIn() && (
        (isOwner(existing().ownerId) && isValidProduct(incoming()) 
          && incoming().ownerId == existing().ownerId
          && incoming().storeId == existing().storeId
          && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'price', 'currency', 'category', 'images', 'buyButtonType', 'buyButtonLink', 'isActive', 'rating', 'reviewCount', 'likeCount', 'updatedAt', 'ownerId', 'storeId', '_syncedAt']))
        || (incoming().diff(existing()).affectedKeys().hasOnly(['rating', 'reviewCount', 'likeCount']))
      );
      allow delete: if isOwner(existing().ownerId);
    }

    match /notifications/{id} {
      allow get, delete: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && incoming().fromUserId == request.auth.uid;
      allow update: if isOwner(existing().userId) && incoming().diff(existing()).affectedKeys().hasOnly(['read', 'updatedAt', '_syncedAt']);
    }

    match /conversations/{convoId} {
      allow create: if isSignedIn() && request.auth.uid in incoming().participants;
      allow get, update: if isSignedIn() && request.auth.uid in existing().participants;
      allow list: if isSignedIn() && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow get: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        allow list: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
        allow create: if isSignedIn() && isValidId(messageId) && isValidMessage(incoming())
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(convoId)).data.participants;
      }
    }

    match /reviews/{reviewId} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isVerified() && isValidId(reviewId) && isValidReview(incoming());
      allow delete: if isOwner(existing().userId);
    }

    match /follows/{id} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && (resource.data.userId == request.auth.uid || resource.data.storeId is string);
      allow create: if isSignedIn() && isValidId(id) && incoming().userId == request.auth.uid;
      allow delete: if isOwner(existing().userId);
    }

    match /storeLikes/{id} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(id) && incoming().userId == request.auth.uid;
      allow delete: if isOwner(existing().userId);
    }

    match /productLikes/{id} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(id) && incoming().userId == request.auth.uid;
      allow delete: if isOwner(existing().userId);
    }
    
    match /engagements/{id} {
      allow get: if isSignedIn() && (resource.data.supplierId == request.auth.uid || resource.data.customerId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.supplierId == request.auth.uid || resource.data.customerId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(id) && incoming().customerId == request.auth.uid;
    }

    match /deals/{id} {
      allow get: if isSignedIn() && (resource.data.supplierId == request.auth.uid || resource.data.customerId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.supplierId == request.auth.uid || resource.data.customerId == request.auth.uid);
      allow create: if isVerified() && isValidId(id) && (incoming().supplierId == request.auth.uid || incoming().customerId == request.auth.uid);
      allow update: if isVerified() && (existing().supplierId == request.auth.uid || existing().customerId == request.auth.uid);
    }

    match /spotlights/{id} {
      allow get: if true;
      allow list: if isSignedIn();
      allow create: if isVerified() && isValidId(id) && isValidSpotlight(incoming());
      allow update: if isOwner(existing().authorId) && isValidSpotlight(incoming())
        && incoming().authorId == existing().authorId
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'type', 'image', 'location', 'date', 'isActive', 'updatedAt', 'authorId', 'authorName', 'createdAt', '_syncedAt']);
      allow delete: if isOwner(existing().authorId);
    }

    match /connections/{id} {
      allow get: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow list: if isSignedIn() && (resource.data.senderId == request.auth.uid || resource.data.receiverId == request.auth.uid);
      allow create: if isSignedIn() && isValidId(id) && incoming().senderId == request.auth.uid;
      allow update: if isSignedIn() && (
        (existing().receiverId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'type', 'updatedAt', '_syncedAt'])) ||
        (existing().senderId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt', '_syncedAt']))
      );
      allow delete: if isSignedIn() && (existing().senderId == request.auth.uid || existing().receiverId == request.auth.uid);
    }
  }
}
