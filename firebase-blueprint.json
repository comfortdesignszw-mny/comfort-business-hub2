{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "User profile containing both customer and supplier persona data.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "avatar": { "type": "string" },
        "currentRole": { "type": "string", "enum": ["customer", "supplier"] },
        "geohash": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "businessName": { "type": "string" },
        "businessCategory": { "type": "string" },
        "whatsappUrl": { "type": "string" },
        "avatar": { "type": "string" },
        "location": {
          "type": "object",
          "properties": {
            "city": { "type": "string" },
            "address": { "type": "string" },
            "coordinates": {
              "type": "object",
              "properties": {
                "lat": { "type": "number" },
                "lng": { "type": "number" }
              }
            }
          }
        },
        "gateway": {
          "type": "object",
          "properties": {
            "provider": { "type": "string", "enum": ["paypal", "stripe", "paynow", "custom"] },
            "details": { "type": "string" },
            "isActive": { "type": "boolean" }
          }
        },
        "isVerified": { "type": "boolean" },
        "isAdmin": { "type": "boolean" },
        "status": { "type": "string", "enum": ["active", "suspended", "banned"] },
        "suspensionEnd": { "type": "string", "format": "date-time" },
        "reportCount": { "type": "number" },
        "requiredProducts": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "phone", "currentRole"]
    },
    "Store": {
      "title": "Supplier Store",
      "description": "Storefront information for suppliers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "contactNumbers": { "type": "array", "items": { "type": "string" } },
        "email": { "type": "string" },
        "category": { "type": "string" },
        "specificBusinessType": { "type": "string" },
        "geohash": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "logo": { "type": "string" },
        "coverPhoto": { "type": "string" },
        "address": { "type": "string" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "followerCount": { "type": "number" },
        "likeCount": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "ownerId", "name", "geohash", "email", "contactNumbers"]
    },
    "Product": {
      "title": "Marketplace Product",
      "description": "Goods or services offered by suppliers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeId": { "type": "string" },
        "ownerId": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "currency": { "type": "string" },
        "category": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "buyButtonType": { "type": "string", "enum": ["checkout", "chat", "link"] },
        "buyButtonLink": { "type": "string" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" },
        "likeCount": { "type": "number" },
        "isActive": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "storeId", "ownerId", "name", "price", "buyButtonType"]
    },
    "Review": {
      "title": "Product Review",
      "description": "User ratings and feedback for specific products.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userAvatar": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "rating", "createdAt"]
    },
    "Deal": {
      "title": "Marketplace Deal (Negotiation)",
      "description": "Active negotiations between customers and suppliers.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "customerId": { "type": "string" },
        "supplierId": { "type": "string" },
        "productId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "quoted", "accepted", "delivered", "cancelled"] },
        "agreedPrice": { "type": "number" },
        "customerNotes": { "type": "string" },
        "supplierNotes": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Message": {
      "title": "Chat Message",
      "description": "Real-time message in a conversation.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "conversationId": { "type": "string" },
        "senderId": { "type": "string" },
        "text": { "type": "string" },
        "type": { "type": "string", "enum": ["text", "quote", "location", "image"] },
        "payload": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Conversation": {
      "title": "Chat Conversation",
      "description": "Shared record for a chat between two users.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "participants": { "type": "array", "items": { "type": "string" } },
        "lastMessage": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      }
    },
    "Spotlight": {
      "title": "Market Spotlight / News / Classified Ads",
      "description": "Updates, events, news feeds, and timeframed classified ads posted by suppliers and members.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "type": { "type": "string", "enum": ["news", "event", "update", "spotlight", "classified"] },
        "title": { "type": "string" },
        "content": { "type": "string" },
        "image": { "type": "string" },
        "location": { "type": "string" },
        "date": { "type": "string" },
        "isActive": { "type": "boolean" },
        "isClassified": { "type": "boolean" },
        "category": { "type": "string" },
        "price": { "type": "string" },
        "badge": { "type": "string" },
        "durationHours": { "type": "number" },
        "expiresAt": { "type": "string", "format": "date-time" },
        "contactPhone": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "actionUrl": { "type": "string" },
        "targetType": { "type": "string", "enum": ["chat", "whatsapp", "call", "store", "external"] },
        "tier": { "type": "string", "enum": ["standard", "featured", "vip_banner"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "authorId", "type", "title", "content"]
    },
    "Engagement": {
      "title": "Node Engagement Signal",
      "description": "Records of customers engaging with or showing interest in products.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "productName": { "type": "string" },
        "customerId": { "type": "string" },
        "customerName": { "type": "string" },
        "supplierId": { "type": "string" },
        "type": { "type": "string", "enum": ["engaged", "interested"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "customerId", "supplierId", "type"]
    },
    "Follow": {
      "title": "Store Follow",
      "description": "Relationship between a user and a store they follow.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["storeId", "userId", "createdAt"]
    },
    "StoreLike": {
      "title": "Store Like",
      "description": "User liking a store.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "storeId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["storeId", "userId", "createdAt"]
    },
    "ProductLike": {
      "title": "Product Like",
      "description": "User liking a product.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["productId", "userId", "createdAt"]
    },
    "Notification": {
      "title": "User Notification",
      "description": "Alerts for user interactions.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "type": { "type": "string", "enum": ["engage", "buy", "rate", "follow", "like_store", "like_product"] },
        "fromUserId": { "type": "string" },
        "fromUserName": { "type": "string" },
        "targetId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "type", "fromUserId", "createdAt"]
    },
    "Report": {
      "title": "Abuse Report",
      "description": "Report of substandard or abusive content.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "reporterId": { "type": "string" },
        "reporterName": { "type": "string" },
        "targetId": { "type": "string" },
        "targetType": { "type": "string", "enum": ["product", "store", "user"] },
        "targetName": { "type": "string" },
        "ownerId": { "type": "string" },
        "type": { "type": "string", "enum": ["substandard", "misinformation", "illegal", "nudity", "violence"] },
        "details": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "resolved", "dismissed"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["reporterId", "targetId", "targetType", "type", "details", "createdAt"]
    }
  },
  "firestore": {
    "users": {
      "schema": "User",
      "description": "User profiles"
    },
    "stores": {
      "schema": "Store",
      "description": "Supplier store locations"
    },
    "products": {
      "schema": "Product",
      "description": "Supplier items"
    },
    "deals": {
      "schema": "Deal",
      "description": "Active business deals"
    },
    "conversations": {
      "schema": "Conversation",
      "description": "Chat metadata"
    },
    "conversations/{convoId}/messages": {
      "schema": "Message",
      "description": "Chat messages within a conversation"
    },
    "spotlights": {
      "schema": "Spotlight",
      "description": "Market news and events"
    },
    "engagements": {
      "schema": "Engagement",
      "description": "Product interaction logs"
    },
    "reviews": {
      "schema": "Review",
      "description": "Product feedback and ratings"
    },
    "follows": {
      "schema": "Follow",
      "description": "Store follows"
    },
    "storeLikes": {
      "schema": "StoreLike",
      "description": "Store likes"
    },
    "productLikes": {
      "schema": "ProductLike",
      "description": "Product likes"
    },
    "notifications": {
      "schema": "Notification",
      "description": "User notification alerts"
    },
    "reports": {
      "schema": "Report",
      "description": "Abuse and quality reports"
    }
  }
}
